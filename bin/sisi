#!/usr/bin/env python3
import os, sys
# sisi never writes inside the product: compiled bytecode goes to the scratch dir instead of next to the code.
_xdg = os.environ.get("XDG_STATE_HOME")
_state = os.environ.get("SISI_STATE") or os.path.join(_xdg or os.path.join(os.path.expanduser("~"), ".local", "state"), "sisi")
sys.pycache_prefix = os.path.join(_state, "pycache")
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from sisi.cli import main
sys.exit(main(sys.argv[1:]))
