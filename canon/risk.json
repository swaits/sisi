{
  "profiles": ["trivial", "isolated", "logic", "integration", "data", "critical", "release"],
  "requirements": {
    "trivial": {"contract": false, "checks": "the diff; a targeted check when one exists", "requirement_model": false, "risk_note": false, "independent_evidence": false, "retro": "only on an anomaly (two send-backs, or a human correction)"},
    "isolated": {"contract": true, "checks": "at least one that is not vacuous", "requirement_model": false, "risk_note": false, "independent_evidence": false, "retro": "yes"},
    "logic": {"contract": true, "checks": "as isolated, each with covers", "requirement_model": false, "risk_note": false, "independent_evidence": false, "retro": "yes"},
    "integration": {"contract": true, "checks": "as logic, plus invariants", "requirement_model": true, "risk_note": true, "independent_evidence": false, "retro": "yes"},
    "data": {"contract": true, "checks": "as integration", "requirement_model": true, "risk_note": true, "independent_evidence": true, "retro": "yes"},
    "critical": {"contract": true, "checks": "as integration", "requirement_model": true, "risk_note": true, "independent_evidence": true, "retro": "yes"},
    "release": {"contract": true, "checks": "every check (--all)", "requirement_model": true, "risk_note": true, "independent_evidence": true, "retro": "yes"}
  },
  "patterns": [
    {"glob": "**/migrations/**", "profile": "data", "reason": "database migration changes stored data shape"},
    {"glob": "**/migration/**", "profile": "data", "reason": "data migration code"},
    {"glob": "**/*.sql", "profile": "data", "reason": "SQL changes stored data or schema"},
    {"glob": "**/schema/**", "profile": "data", "reason": "schema definition"},
    {"glob": "**/*.schema.*", "profile": "data", "reason": "schema definition"},
    {"glob": "**/alembic/**", "profile": "data", "reason": "database migration history"},
    {"glob": "**/db/**", "profile": "data", "reason": "persistence layer"},
    {"glob": "**/storage/**", "profile": "data", "reason": "persistence layer"},
    {"glob": "**/persist*/**", "profile": "data", "reason": "persistence layer"},
    {"glob": "**/auth/**", "profile": "critical", "reason": "authorization or authentication code"},
    {"glob": "**/*auth*", "profile": "critical", "reason": "authorization or authentication code"},
    {"glob": "**/*secret*", "profile": "critical", "reason": "secret handling"},
    {"glob": "**/*crypto*", "profile": "critical", "reason": "cryptography"},
    {"glob": "**/*encrypt*", "profile": "critical", "reason": "cryptography"},
    {"glob": "**/*payment*", "profile": "critical", "reason": "payments move money"},
    {"glob": "**/*billing*", "profile": "critical", "reason": "billing moves money"},
    {"glob": "**/*mutex*", "profile": "critical", "reason": "concurrency primitive"},
    {"glob": "**/*semaphore*", "profile": "critical", "reason": "concurrency primitive"},
    {"glob": "**/*lock*", "profile": "critical", "reason": "concurrency primitive"},
    {"glob": "**/hooks/**", "profile": "critical", "reason": "hook wiring runs on every session"},
    {"glob": "**/*hook*", "profile": "critical", "reason": "hook wiring runs automatically"},
    {"glob": "**/install*", "profile": "critical", "reason": "installer changes the user's machine"},
    {"glob": "install*", "profile": "critical", "reason": "installer changes the user's machine"},
    {"glob": "**/setup.py", "profile": "critical", "reason": "installer runs at install time"},
    {"glob": "**/PKGBUILD", "profile": "critical", "reason": "package build script runs as root tooling"},
    {"glob": "VERSION", "profile": "release", "reason": "version marker for a release"},
    {"glob": "**/release/**", "profile": "release", "reason": "release machinery"},
    {"glob": "**/*release*", "profile": "release", "reason": "release machinery"},
    {"glob": "**/api/**", "profile": "integration", "reason": "public interface surface"},
    {"glob": "**/public/**", "profile": "integration", "reason": "public interface surface"},
    {"glob": "include/**", "profile": "integration", "reason": "public headers are an interface"},
    {"glob": "**/parser/**", "profile": "logic", "reason": "parsing logic has a broad input space"},
    {"glob": "**/*pars*", "profile": "logic", "reason": "parsing logic has a broad input space"},
    {"glob": "**/*lexer*", "profile": "logic", "reason": "lexing logic has a broad input space"},
    {"glob": "**/*codec*", "profile": "logic", "reason": "encode/decode logic"},
    {"glob": "**/money/**", "profile": "logic", "reason": "money arithmetic must be exact"},
    {"glob": "**/*money*", "profile": "logic", "reason": "money arithmetic must be exact"},
    {"glob": "**/*rounding*", "profile": "logic", "reason": "rounding rules decide money"},
    {"glob": "**/*pricing*", "profile": "logic", "reason": "pricing arithmetic"},
    {"glob": "**/algo*/**", "profile": "logic", "reason": "algorithmic logic"},
    {"glob": "**/*algorithm*", "profile": "logic", "reason": "algorithmic logic"},
    {"glob": "**/*state-machine*", "profile": "logic", "reason": "state machine transitions"},
    {"glob": "**/*statemachine*", "profile": "logic", "reason": "state machine transitions"},
    {"glob": "**/*.md", "profile": "trivial", "reason": "documentation only"},
    {"glob": "**/*.txt", "profile": "trivial", "reason": "plain text only"},
    {"glob": "**/*.rst", "profile": "trivial", "reason": "documentation only"},
    {"glob": "docs/**", "profile": "trivial", "reason": "documentation only"},
    {"glob": "**/*.css", "profile": "trivial", "reason": "styling only"},
    {"glob": "**/*.scss", "profile": "trivial", "reason": "styling only"},
    {"keyword": "migration", "profile": "data", "reason": "diff mentions a data migration"},
    {"keyword": "schema change", "profile": "data", "reason": "diff changes a schema"},
    {"keyword": "alter table", "profile": "data", "reason": "diff alters stored data"},
    {"keyword": "password", "profile": "critical", "reason": "diff handles credentials"},
    {"keyword": "secret", "profile": "critical", "reason": "diff handles secrets"},
    {"keyword": "encrypt", "profile": "critical", "reason": "diff uses cryptography"},
    {"keyword": "authorize", "profile": "critical", "reason": "diff makes authorization decisions"},
    {"keyword": "authentication", "profile": "critical", "reason": "diff handles authentication"},
    {"keyword": "payment", "profile": "critical", "reason": "diff moves money"},
    {"keyword": "mutex", "profile": "critical", "reason": "diff uses a concurrency primitive"},
    {"keyword": "release candidate", "profile": "release", "reason": "diff prepares a release"}
  ]
}
